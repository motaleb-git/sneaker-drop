# Postgres (local docker-compose or Neon pooled URL)
DATABASE_URL=postgres://sneaker:sneaker@localhost:5432/sneaker_drop

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Reservation hold window
RESERVATION_TTL_SECONDS=60

# Versioned migrations always run. SYNC_SCHEMA is an emergency sequelize.sync() only.
SYNC_SCHEMA=false
SWAGGER_ENABLED=true

# Cookie session (HttpOnly). Cross-site deploys: COOKIE_SAMESITE=none and COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Set false on the API process if expiry runs as `npm run worker`
START_EXPIRY_WORKER=true
